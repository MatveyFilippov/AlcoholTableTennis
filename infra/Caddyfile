{$APP_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	@application not path /api/docs
	header @application Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	handle /api/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy api:8000 {
			header_up X-ATT-Client-IP {remote_host}
		}
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control no-cache
		file_server
	}
}
